# Copy to .env.local. Never commit real values.

# Public site URL (used for canonical URLs, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase. Leave these empty to run in demo mode (seed posts, admin shows setup steps).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Used by `npm run create-admin` and `npm run seed`. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
